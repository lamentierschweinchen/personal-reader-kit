{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "node --version",
  "routes": [
    {
      "src": "^/\\.well-known(?:/.*)?$"
    },
    {
      "src": "^/((?:[^/]+/)*[^/\\.]+)$",
      "headers": {
        "Location": "/$1/"
      },
      "status": 308
    },
    {
      "src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/austen$",
      "headers": {
        "Location": "/austen/"
      },
      "status": 308
    },
    {
      "src": "^/alice$",
      "headers": {
        "Location": "/alice/"
      },
      "status": 308
    },
    {
      "src": "^/walden$",
      "headers": {
        "Location": "/walden/"
      },
      "status": 308
    },
    {
      "src": "^/two-halls$",
      "headers": {
        "Location": "/two-halls/"
      },
      "status": 308
    },
    {
      "src": "^(?:/(.*))$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
        "Permissions-Policy": "geolocation=(), camera=(), microphone=()"
      },
      "continue": true
    },
    {
      "src": "^(?:/(austen|alice|walden|two-halls))/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^(?:/(austen|alice|walden|two-halls))(?:/(.*))$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/personal/index.html",
      "has": [
        {
          "type": "host",
          "value": "read.lookatseel.com"
        }
      ]
    },
    {
      "handle": "filesystem"
    }
  ]
}
