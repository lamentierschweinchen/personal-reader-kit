{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "node --version",
  "trailingSlash": true,
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"},
    {"key":"Permissions-Policy","value":"geolocation=(), camera=(), microphone=()"}
  ]},
  {"source":"/(austen|alice|walden|two-halls)/sw.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
  {"source":"/(austen|alice|walden|two-halls)/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}]}],
  "rewrites":[
    {"source":"/","has":[{"type":"host","value":"read.lookatseel.com"}],"destination":"/personal/index.html"}
  ],
  "redirects":[
    {"source":"/austen","destination":"/austen/","permanent":true},
    {"source":"/alice","destination":"/alice/","permanent":true},
    {"source":"/walden","destination":"/walden/","permanent":true},
    {"source":"/two-halls","destination":"/two-halls/","permanent":true}
  ]
}
