{
  "name": "personal-reader-kit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "audit:public": "node scripts/audit.mjs",
    "import:text": "node scripts/import-text.mjs",
    "check": "npm test && npm run build && npm run audit:public",
    "import:epub": "node scripts/import-epub.mjs",
    "upgrade:check": "node scripts/check-upgrade.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "editorial:check": "node scripts/editorial-review.mjs check",
    "test:cards": "node tests/share-card-browser.mjs",
    "test:preview-local": "node tests/local-preview-browser.mjs",
    "check:icons": "node scripts/check-home-screen.mjs"
  }
}
