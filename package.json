{
  "name": "personal-reader-kit",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "audit:public": "node scripts/audit.mjs",
    "import:text": "node scripts/import-text.mjs",
    "check": "npm test && npm run build && npm run audit:public"
  }
}
